rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /checkpoints/{checkpointId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /patrolRoutes/{routeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.officerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.officerId == request.auth.uid;

      match /scans/{scanId} {
        allow read: if signedIn()
          && (resource.data.officerId == request.auth.uid
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 1);
        allow create: if signedIn()
          && request.resource.data.officerId == request.auth.uid
          && request.resource.data.sessionId == routeId;
      }
    }
  }
}
